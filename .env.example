# ==============================================================================
# Omni Platform - Environment Configuration Reference (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORE DATABASE & CACHING
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Multi-tenant relational data, RBAC, billing, CRM)
DATABASE_URL=postgres://omni:omni@localhost:5432/omni_platform

# Redis connection string (Pub/Sub, WebSocket scaling, BullMQ jobs, session cache)
REDIS_URL=redis://localhost:6379

# MongoDB (High-throughput conversational message archive & audit history)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=omni_platform
MONGODB_TIMEOUT_MS=5000

# Elasticsearch (Distributed full-text & fuzzy search across contacts and messages)
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & ENCRYPTION)
# ------------------------------------------------------------------------------
# JWT secret for signing and verifying tenant and platform user tokens
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# High-privilege platform staff (Super Admin, Developer, Tester) token lifetime
PLATFORM_JWT_EXPIRES_IN=1d

# AES-256-GCM encryption key for encrypting sensitive credentials at rest (32 bytes / 64 hex)
# If left empty, JWT_SECRET is used as fallback
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. META TECH PROVIDER & WHATSAPP EMBEDDED SIGNUP (PLATFORM APP)
# ------------------------------------------------------------------------------
# Meta App credentials from developers.facebook.com for 1-Click Embedded Signup
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0

# Default webhook verification token for Meta WhatsApp Cloud API webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# ------------------------------------------------------------------------------
# 5. AI ENGINE & KNOWLEDGE BASES (RAG)
# ------------------------------------------------------------------------------
# OpenAI API Key (Used for text-embedding-3-small vector embeddings & GPT-4o)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Anthropic API Key (Used for Claude 3.5 Sonnet AI Copilot & Auto-Pilot agents)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ------------------------------------------------------------------------------
# 6. BILLING & PAYMENT GATEWAYS (MULTI-GATEWAY CHECKOUT)
# ------------------------------------------------------------------------------
# Stripe Secret Key (For credit card, Apple Pay, SEPA subscriptions & payment links)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay Credentials (For UPI, Netbanking, Cards subscriptions & orders)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe webhook signing secret (whsec_...). REQUIRED in production when STRIPE_SECRET_KEY is set: without it
# every Stripe webhook is rejected. Create the endpoint at https://<api>/webhooks/payments/stripe and subscribe it
# to: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired,
# invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Razorpay webhook: https://<api>/webhooks/payments/razorpay, events payment_link.paid, payment_link.expired,
# payment_link.cancelled, subscription.charged, subscription.pending, subscription.halted, subscription.cancelled,
# subscription.completed. RAZORPAY_WEBHOOK_SECRET above is REQUIRED in production when Razorpay is configured.

# Public URL of the WEB APP (no trailing slash). Gateways send customers back to <PUBLIC_APP_URL>/settings after paying.
# REQUIRED in production when any gateway is configured.
PUBLIC_APP_URL=http://localhost:5173

# Plan prices are exclusive of tax. India (INR) pays GST on top at this percentage; 0 turns GST off.
# A customer in the SAME state as the seller pays CGST + SGST (half the rate each), any other state pays IGST.
GST_RATE_PERCENT=18
# Seller details printed on every tax invoice (your GST registration). With GST on (GST_RATE_PERCENT > 0) these four
# are REQUIRED in production: the server refuses to start without them.
SELLER_GSTIN=
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
# Service accounting code (SAC) printed on each invoice line. Ask your CA which code applies to your plans.
SELLER_SAC_CODE=
# Optional. The seller's GST state code (07 = Delhi, 27 = Maharashtra ...). Default: the first two digits of SELLER_GSTIN.
# SELLER_STATE_CODE=
# Letter of Undertaking number printed on export-of-services invoices (customers outside India, billed in USD).
SELLER_LUT_NUMBER=
SELLER_PAN=

# ------------------------------------------------------------------
# Invoices: PDF + email (plan/018). The PDF is always created and stored; these only control EMAILING it.
# ------------------------------------------------------------------
# Master switch. false = no invoice or receipt email is ever sent (customers can still download the PDF in the app).
INVOICE_EMAIL_ENABLED=true
# true = attach the invoice PDF to the email. false = send the HTML receipt without an attachment.
INVOICE_PDF_ATTACH=true
# Optional: an address (your accountant) that receives a silent copy (BCC) of every invoice email.
INVOICE_BCC_EMAIL=
# Optional: a separate bucket for invoice PDFs (tax records are kept for years: give it its own retention rules and
# NO expiry/lifecycle deletion). Default: the media bucket, under an "invoices/" prefix no media route can read.
# INVOICE_S3_BUCKET=

# ------------------------------------------------------------------
# Plan lifecycle (auto-renewing subscriptions, plan/017 Phase 3)
# ------------------------------------------------------------------
# What the hourly job does with plans whose paid period ended:
#   off      = job disabled
#   warn     = (DEFAULT) only LOGS which workspaces it would move to the Free plan / remind. Nothing changes, no email.
#   enforce  = moves workspaces whose period + grace ended to the Free plan, and emails reminders for prepaid plans
# Start in warn, read the log (it says how many workspaces would be affected), then switch to enforce.
PLAN_LIFECYCLE_MODE=warn
# Days a plan keeps working after its paid period ended (time for a retried renewal to succeed)
PLAN_GRACE_DAYS=3
# Days before a prepaid (non auto-renewing) plan ends that the reminder email is sent
PLAN_EXPIRY_REMINDER_DAYS=3
# How often the job runs, in milliseconds (default 3600000 = 1 hour)
# PLAN_LIFECYCLE_INTERVAL_MS=3600000

# ------------------------------------------------------------------
# Plan limits and feature flags (plan/017, Phase 4)
# ------------------------------------------------------------------
# Whether a workspace's plan is enforced (channels, contacts, monthly messages, monthly AI requests, and the
# plan's feature flags: AI, API keys, audit/GDPR tools, teams & roles; a suspended workspace becomes read-only):
#   off      = nothing is checked
#   warn     = (DEFAULT) nothing is blocked; what WOULD be blocked is logged and counted. Review it at
#              GET /api/platform/plans/enforcement-report (super admin) before switching to enforce.
#   enforce  = over-limit / locked requests get HTTP 402 { code: PLAN_LIMIT_REACHED | FEATURE_NOT_IN_PLAN }
# Customers' inbound messages and auto-created contacts are never blocked, in any mode.
PLAN_ENFORCEMENT=warn

# Development only. true = every paid checkout uses a SIMULATED gateway: no provider keys needed, the payment is
# "confirmed" instantly, and the plan activates with the same server-side price, GST, ledger row and invoice as a real
# payment. Use it to try the whole flow locally. Must be false/unset in production (the server refuses to start with it
# on in production). To test the real providers instead, keep this false and use their TEST-mode keys.
BILLING_SANDBOX=false

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP FOR SUPPORT TICKETS & NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST blank or unconfigured to operate in simulated sandbox email mode
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM_EMAIL=support@omniplatform.io
SMTP_FROM_NAME="Omni Platform Support"

# ------------------------------------------------------------------------------
# 8. S3 OBJECT STORAGE (MEDIA ATTACHMENTS & ASSETS)
# ------------------------------------------------------------------------------
# Point MEDIA_S3_ENDPOINT at MinIO for local development; leave empty for AWS S3
MEDIA_BUCKET=omni-platform-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
# Public base URL of this API, no trailing slash (e.g. https://api.example.com). Optional.
# When set, media links for WhatsApp/Telegram and webchat visitors are signed links served by
# this API (/api/media/file), so object storage does not have to be publicly reachable.
# When empty, outbound media uses object-storage presigned URLs. Set it in production.
PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 9. BACKGROUND AUTOMATION & CAMPAIGN SCHEDULER
# ------------------------------------------------------------------------------
# Polling interval in ms for due drip campaign steps and broadcast messages
DRIP_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 10. HOST & CORS URLS (OPTIONAL PLATFORM REFERENCE)
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:5173
